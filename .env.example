# Copy to .env.local for local work, and set the same names in Vercel (Project, Settings, Environment Variables).
# Leave the Supabase values empty to run in device only mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by the daily backup job.
SUPABASE_SERVICE_ROLE_KEY=
# Vercel sends this as a bearer token to the cron route.
CRON_SECRET=
# Server only. The one account, and the password typed once per device.
OWNER_EMAIL=
ACCESS_PASSWORD=
# Local development and tests only: an in memory sync server at /api/dev-sync.
# SYNC_MODE=memory
# NEXT_PUBLIC_SYNC_MODE=memory
